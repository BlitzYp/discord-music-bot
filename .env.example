# Discord application (Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Bot owner (your Discord user ID)
OWNER_ID=

# Web
SESSION_SECRET=
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Lavalink (password must match lavalink/application.yml)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me

# Optional: register slash commands to one server only (instant updates while developing)
DEV_GUILD_ID=

# Optional: lets Jarvis (the AI bot, ../Keith-AI) control the music and turn it down while it talks.
# A random string of 32+ characters; put the same one in Jarvis's .env as MUSIC_BOT_KEY. Empty = off.
INTEGRATION_KEY=
