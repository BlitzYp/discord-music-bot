{
  "name": "discord-music-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lavalink": "node scripts/lavalink.mjs",
    "funnel": "node scripts/funnel.mjs",
    "setup:lavalink": "node scripts/download-lavalink.mjs",
    "setup:ytdlp": "node scripts/download-ytdlp.mjs",
    "setup:piper": "node scripts/download-piper.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lavalink-client": "^2.11.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
